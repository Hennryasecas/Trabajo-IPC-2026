<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>


<SplitPane
    fx:id="splitPane"
    dividerPositions="0.72"
    orientation="VERTICAL"
    prefHeight="550.0"
    prefWidth="850.0"
    style="-fx-background-color: #F0F4FA;"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="mapademo.AdjuntosFXML.VistaMapaEntrenamientoController">

  <items>

    <!-- ══════════════════════════════════════════════════
         PANEL SUPERIOR: Estadísticas + Mapa
    ══════════════════════════════════════════════════ -->
    <AnchorPane minHeight="0.0" minWidth="0.0">
      <children>

        <!-- Barra de estadísticas (nueva, parte de Hugo) -->
        <FlowPane
            fx:id="barraStats"
            hgap="20" vgap="4"
            style="-fx-background-color: #DDEEFF; -fx-padding: 6 12 6 12; -fx-border-color: #B0C8E8; -fx-border-width: 0 0 1 0;"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">
          <children>
            <VBox spacing="1">
              <Label text="DISTANCIA" style="-fx-font-size:9px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
              <Label fx:id="lblDistancia" text="— km" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="DURACIÓN" style="-fx-font-size:9px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
              <Label fx:id="lblDuracion" text="—" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="VEL. MEDIA" style="-fx-font-size:9px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
              <Label fx:id="lblVelocidad" text="— km/h" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="RITMO" style="-fx-font-size:9px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
              <Label fx:id="lblRitmo" text="— min/km" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="DESNIVEL +" style="-fx-font-size:9px; -fx-text-fill:#27ae60; -fx-font-weight:bold;"/>
              <Label fx:id="lblDesnivel" text="— m" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#27ae60;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="DESNIVEL −" style="-fx-font-size:9px; -fx-text-fill:#e74c3c; -fx-font-weight:bold;"/>
              <Label fx:id="lblDesnivelNeg" text="— m" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#e74c3c;"/>
            </VBox>
            <VBox spacing="1">
              <Label text="ALT. MÍN/MÁX" style="-fx-font-size:9px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
              <Label fx:id="lblAltitud" text="— / — m" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
            </VBox>
          </children>
        </FlowPane>

        <!-- Contenedor del mapa (estructura original de Dennis) -->
        <AnchorPane
            AnchorPane.topAnchor="48.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">
          <children>

            <!-- ScrollPane + Group + ImageView: estructura original de Dennis -->
            <ScrollPane
                fx:id="ScrollPane"
                styleClass="map-area"
                stylesheets="@../Diseños%20CSS/layout.css"
                AnchorPane.topAnchor="10.0"
                AnchorPane.bottomAnchor="10.0"
                AnchorPane.leftAnchor="10.0"
                AnchorPane.rightAnchor="90.0">
              <content>
                <Group fx:id="Group">
                  <children>
                    <ImageView
                        fx:id="mapa"
                        fitHeight="486.0"
                        fitWidth="685.0"
                        pickOnBounds="true"
                        preserveRatio="true">
                      <image>
                        <Image url="@../../resources/calderona.jpg" />
                      </image>
                    </ImageView>

                    <!-- Label de posición del ratón (Dennis) -->
                    <Label fx:id="mousePositionLabel"
                           layoutX="4" layoutY="4"
                           prefHeight="18.0" prefWidth="200.0"
                           style="-fx-font-size:10px; -fx-text-fill:#333;"/>

                    <!--
                        Chincheta (Hugo): marcador que se mueve al hacer hover
                        en la gráfica de desnivel. Invisible por defecto.
                        mouseTransparent=true para no bloquear clics en el mapa.
                    -->
                    <ImageView
                        fx:id="chincheta"
                        fitWidth="24" fitHeight="32"
                        preserveRatio="true"
                        visible="false"
                        mouseTransparent="true"/>

                  </children>
                </Group>
              </content>
            </ScrollPane>

            <!-- Panel de zoom: slider vertical + botones (Dennis, sin cambios) -->
            <VBox
                alignment="TOP_CENTER"
                spacing="10.0"
                style="-fx-padding: 10 0 10 0;"
                AnchorPane.topAnchor="10.0"
                AnchorPane.bottomAnchor="10.0"
                AnchorPane.rightAnchor="10.0">
              <children>
                <Button fx:id="botonSumar"
                        text="+"
                        mnemonicParsing="false"
                        styleClass="button-icon"
                        stylesheets="@../Diseños%20CSS/buttons.css"/>
                <Button fx:id="botonRestar"
                        text="-"
                        mnemonicParsing="false"
                        styleClass="button-icon"
                        stylesheets="@../Diseños%20CSS/buttons.css"/>
                <Slider
                    fx:id="Slider"
                    orientation="VERTICAL"
                    prefHeight="154.0"
                    prefWidth="16.0"
                    style="-fx-background-color: #2196F3; -fx-background-radius: 4px;"/>
              </children>
            </VBox>

          </children>
        </AnchorPane>

      </children>
    </AnchorPane>

   
    <AnchorPane minHeight="0.0" minWidth="0.0">
      <children>

        <Label text="PERFIL DE DESNIVEL"
               style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#555; -fx-padding: 4 0 0 8;"
               AnchorPane.topAnchor="0.0"
               AnchorPane.leftAnchor="0.0"/>

        <AreaChart
            fx:id="grafica"
            animated="false"
            styleClass="stats-panel"
            stylesheets="@../Diseños%20CSS/layout.css"
            AnchorPane.topAnchor="18.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">
          <xAxis>
            <!--
                IMPORTANTE: NumberAxis (no CategoryAxis) para que el controller
                pueda usar getLowerBound/getUpperBound y calcular el hover.
            -->
            <NumberAxis fx:id="ejeX" label="Distancia (km)" autoRanging="true" minorTickVisible="false"/>
          </xAxis>
          <yAxis>
            <NumberAxis fx:id="ejeY" label="Altitud (m)" autoRanging="true" minorTickVisible="false"/>
          </yAxis>
        </AreaChart>

      </children>
    </AnchorPane>

  </items>
</SplitPane>

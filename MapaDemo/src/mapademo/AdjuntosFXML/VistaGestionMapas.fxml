<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="mapademo.AdjuntosFXML.VistaGestionMapasController"
            stylesheets="@../../resources/estilos.css"
            prefWidth="900" prefHeight="600">

    <!-- ══════════════════════════════════════════════════════
         TOP — Cabecera
    ══════════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cabecera-panel"
              style="-fx-padding: 12 16 12 16;">
            <Button fx:id="btnVolver" text="← Volver" onAction="#handleVolver"
                    styleClass="btn-secundario"/>
            <Label text="Gestión de Mapas" styleClass="titulo-seccion"/>
        </HBox>
    </top>

  
    <left>
        <VBox styleClass="panel-lateral" spacing="10" minWidth="220" maxWidth="260"
              style="-fx-padding: 16;">
            <Label text="MAPAS REGISTRADOS" styleClass="panel-titulo"/>

            <ListView fx:id="listMapas" prefHeight="380" VBox.vgrow="ALWAYS"
                      styleClass="lista-mapas"/>

            <!-- Previsualización del mapa seleccionado -->
            <Label text="Vista previa:" styleClass="label-campo"/>
            <ImageView fx:id="previsualizacion" fitWidth="200" fitHeight="110"
                       preserveRatio="true" style="-fx-border-color: #555; -fx-border-width: 1;"/>

            <Button fx:id="btnEliminarMapa" text="🗑 Eliminar seleccionado"
                    onAction="#handleEliminarMapa" maxWidth="Infinity"
                    styleClass="btn-peligro" disable="true"/>
        </VBox>
    </left>

 
    <center>
        <VBox styleClass="panel-formulario" spacing="18"
              style="-fx-padding: 24 32 24 32;">

            <Label text="AÑADIR NUEVO MAPA" styleClass="panel-titulo-grande"/>

            <!-- Nombre del mapa -->
            <VBox spacing="4">
                <Label text="Nombre de la región *" styleClass="label-campo"/>
                <TextField fx:id="txtNombre" promptText="Ej: Montanejos"
                           styleClass="input-campo">
                    <tooltip><Tooltip text="Nombre identificativo de la región del mapa"/></tooltip>
                </TextField>
                <Label fx:id="errNombre" styleClass="label-error" visible="false"
                       managed="false"/>
            </VBox>

            <!-- Fichero JPG -->
            <VBox spacing="4">
                <Label text="Imagen del mapa (JPG) *" styleClass="label-campo"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtRutaImagen" promptText="Selecciona un fichero JPG…"
                               styleClass="input-campo" editable="false" HBox.hgrow="ALWAYS"/>
                    <Button text="📂 Examinar…" onAction="#handleSeleccionarImagen"
                            styleClass="btn-secundario"/>
                </HBox>
                <Label fx:id="errImagen" styleClass="label-error" visible="false"
                       managed="false"/>
            </VBox>

            <Separator/>

          
           
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Bounding Box (coordenadas geográficas) *"
                           styleClass="label-campo"/>
                    <Label text="ⓘ" style="-fx-text-fill: #3498db; -fx-font-size: 13px;">
                        <tooltip>
                            <Tooltip text="Usa EXACTAMENTE los valores que imprime el script generar_mapas_hd.py.&#10;Valores aproximados producirán proyecciones incorrectas.&#10;&#10;Rango válido: Latitud −90 a 90 · Longitud −180 a 180"/>
                        </tooltip>
                    </Label>
                </HBox>

                <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Fila 0: etiquetas -->
                    <Label text="Latitud mínima (Sur)  *" styleClass="label-campo"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Latitud máxima (Norte) *" styleClass="label-campo"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <!-- Fila 1: inputs lat -->
                    <TextField fx:id="txtLatMin" promptText="Ej: 39.334297"
                               styleClass="input-campo input-coord"
                               GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <tooltip><Tooltip text="Latitud mínima: entre −90 y 90 grados decimales"/></tooltip>
                    </TextField>
                    <TextField fx:id="txtLatMax" promptText="Ej: 39.554883"
                               styleClass="input-campo input-coord"
                               GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <tooltip><Tooltip text="Latitud máxima: entre −90 y 90, mayor que la mínima"/></tooltip>
                    </TextField>

                    <!-- Fila 2: etiquetas lon -->
                    <Label text="Longitud mínima (Oeste) *" styleClass="label-campo"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label text="Longitud máxima (Este) *" styleClass="label-campo"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <!-- Fila 3: inputs lon -->
                    <TextField fx:id="txtLonMin" promptText="Ej: −0.505371"
                               styleClass="input-campo input-coord"
                               GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <tooltip><Tooltip text="Longitud mínima: entre −180 y 180 grados decimales"/></tooltip>
                    </TextField>
                    <TextField fx:id="txtLonMax" promptText="Ej: −0.285645"
                               styleClass="input-campo input-coord"
                               GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <tooltip><Tooltip text="Longitud máxima: entre −180 y 180, mayor que la mínima"/></tooltip>
                    </TextField>

                    <!-- Fila 4: mensaje de error global de coordenadas -->
                    <Label fx:id="errCoordenadas" styleClass="label-error"
                           visible="false" managed="false" wrapText="true"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"
                           GridPane.columnSpan="2"/>
                </GridPane>
            </VBox>

            <!-- Botones de acción -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                <Button fx:id="btnAnadirMapa" text="✚ Añadir mapa" onAction="#handleAnadirMapa"
                        styleClass="btn-primario"/>
                <Button text="✕ Limpiar" onAction="#handleLimpiarFormulario"
                        styleClass="btn-secundario"/>
            </HBox>

            <!-- Mensaje de resultado -->
            <Label fx:id="lblResultado" styleClass="label-resultado"
                   visible="false" managed="false" wrapText="true"/>

        </VBox>
    </center>

</BorderPane>

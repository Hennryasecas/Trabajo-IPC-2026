<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    ============================================================
    EJEMPLO de uso de los CSS en un FXML de JavaFX
    Running la Safor — Login / Dashboard / Modal

    CÓMO REFERENCIAR LOS CSS EN TU FXML:
    Coloca los 4 ficheros CSS en la misma carpeta que tus FXML
    (o en /resources/styles/) y referencíalos en el nodo raíz:

        <stylesheets>
            <URL value="@buttons.css"/>
            <URL value="@typography.css"/>
            <URL value="@inputs.css"/>
            <URL value="@layout.css"/>
            <URL value="@components.css"/>
        </stylesheets>

    Puedes incluir todos en la vista raíz (StackPane, BorderPane…)
    o solo los que necesite cada pantalla.
    ============================================================
-->

<!-- ══════════════════════════════════════════
     1. PANTALLA DE LOGIN
     ══════════════════════════════════════════ -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           styleClass="root-background">

    <stylesheets>
        <URL value="@buttons.css"/>
        <URL value="@typography.css"/>
        <URL value="@inputs.css"/>
        <URL value="@layout.css"/>
        <URL value="@components.css"/>
    </stylesheets>

    <!-- Tarjeta de Login centrada -->
    <VBox styleClass="card" maxWidth="400" spacing="16" alignment="CENTER">
        <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

        <!-- Avatar app -->
        <StackPane styleClass="avatar-circle" alignment="CENTER"
                   VBox.vgrow="NEVER">
            <Label text="🏃" style="-fx-font-size:28px;"/>
        </StackPane>

        <!-- Título -->
        <Label text="Running la Safor" styleClass="title-app"/>
        <Label text="Bienvenido de vuelta" styleClass="subtitle-app"/>

        <!-- Campo Nickname -->
        <VBox spacing="4">
            <Label text="Nickname" styleClass="label-field"/>
            <TextField promptText="Tu nickname"
                       styleClass="text-field-base"
                       maxWidth="Infinity"/>
        </VBox>

        <!-- Campo Contraseña -->
        <VBox spacing="4">
            <Label text="Contraseña" styleClass="label-field"/>
            <PasswordField promptText="••••••••"
                           styleClass="password-field-base"
                           maxWidth="Infinity"/>
        </VBox>

        <!-- Botón principal -->
        <Button text="Entrar"
                styleClass="button-primary"
                maxWidth="Infinity"/>

        <!-- Link registro -->
        <Button text="¿Eres nuevo? Crea una cuenta aquí"
                styleClass="button-link"/>
    </VBox>
</StackPane>


